# Copy to frontend/.env.e2e.local; keep that local file private and ignored.
# Dedicated identities only. Leave values blank until configured locally.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8080
E2E_KEYCLOAK_URL=http://localhost:8082
E2E_USERNAME=
E2E_PASSWORD=
E2E_ORGANISATION_ID=
E2E_INCIDENT_ID=
E2E_SECOND_ORGANISATION_ID=
E2E_ASSIGNEE_USER_ID=
E2E_ENGINEER_USERNAME=
E2E_ENGINEER_PASSWORD=
E2E_VIEWER_USERNAME=
E2E_VIEWER_PASSWORD=
# Default read-only. Set only for explicitly designated disposable TEST fixtures.
E2E_ALLOW_WRITES=0
# Set both only after reviewing that all visible fixtures contain clean demo data.
E2E_DATA_IS_DEMO=0
E2E_SCREENSHOTS=0
# Optional CI gate: any missing prerequisite makes acceptance exit nonzero.
E2E_REQUIRE_COMPLETE=0
